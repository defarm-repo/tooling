{
  "name": "@defarm/sdk",
  "version": "0.1.6",
  "description": "DeFarm SDK for CLI and partner integrations",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/defarm-repo/tooling.git",
    "directory": "packages/sdk"
  },
