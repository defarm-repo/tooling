# Workspace ingestion API key (required). For SCF review, use the reviewer key
# shared in the SCF Telegram group.
DEFARM_API_KEY=defarm_xxxxxxxxxxxx

# Optional overrides (defaults shown)
# DEFARM_GATEWAY=https://gateway.defarm.net
# DEFARM_CIRCUIT_ID=<uuid>   (optional; auto-discovered from the key when unset)
# PORT=3005
