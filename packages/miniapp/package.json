{
  "name": "@defarm/miniapp",
  "version": "0.1.0",
  "description": "Framework for building standalone applications on top of the DeFarm platform",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/defarm-repo/tooling.git",
    "directory": "packages/miniapp"
  },
  "homepage": "https://defarm.net",
  "bugs": {
    "url": "https://github.com/defarm-repo/tooling/issues"
  },
  "keywords": [
    "defarm",
    "traceability",
    "agri",
    "stellar",
    "miniapp",
    "tokenization"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run check && npm run test"
  },
  "dependencies": {
    "@defarm/sdk": "^0.1.6"
  },
  "devDependencies": {
    "@types/node": "^22.8.2",
    "typescript": "^5.6.3"
  }
}