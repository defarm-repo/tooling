{
  "name": "@defarm/cli",
  "version": "0.1.10",
  "description": "DeFarm CLI",
  "license": "MIT",
  "keywords": [
    "defarm",
    "traceability",
    "agri",
    "cli",
    "stellar"
  ],
  "type": "module",
  "bin": {
    "defarm": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts",
    "test": "DEFARM_SKIP_UPDATE_CHECK=1 npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run check && npm run test"
  },
  "dependencies": {
    "@defarm/sdk": "^0.1.5",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.8.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
